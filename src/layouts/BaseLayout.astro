---
import "@styles/global.css";
import { withBase } from "@lib/path";

const nav = [
  { href: "/", label: "Home" },
  { href: "/visuals/", label: "Visuals" },
  { href: "/stories/", label: "Stories" },
  { href: "/archive/", label: "Archive" },
  { href: "/about/", label: "About" }
];

const { title = "Dipendra Pradhan", description = "Visuals, stories, and observations." } = Astro.props;
const currentPath = Astro.url.pathname;
const currentWithoutBase = currentPath.replace(import.meta.env.BASE_URL.replace(/\/$/, ""), "") || "/";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#10100f" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="site-shell nav">
        <a class="brand" href={withBase("/")}>Dipendra Pradhan</a>
        <nav class="nav-links" aria-label="Primary navigation">
          {nav.map((item) => (
            <a href={withBase(item.href)} aria-current={currentWithoutBase === item.href ? "page" : undefined}>{item.label}</a>
          ))}
        </nav>
      </div>
    </header>
    <main class="site-shell">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="site-shell">A living archive of visuals, stories, observations, and memory.</div>
    </footer>
  </body>
</html>
