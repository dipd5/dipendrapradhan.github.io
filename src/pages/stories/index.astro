---
import BaseLayout from "@layouts/BaseLayout.astro";
import { getStories } from "@lib/archive";
import { formatGardenDate } from "@lib/date";
import { getReadingTime } from "@lib/readingTime";
import { withBase } from "@lib/path";

const stories = await getStories();
---

<BaseLayout title="Stories — Dipendra Pradhan" description="Stories, notes, and observations.">
  <section class="page-intro">
    <p class="eyebrow">Stories</p>

    <h1>आकाशमुनिका कथाहरू</h1>

    <p class="lede">
      People, places, weather, and whatever happened to stay with me.
    </p>
  </section>

  <div class="story-list">
    {stories.map((story) => (
      <a class="story-row" href={withBase(`/stories/${story.id}/`)}>
        <span class="meta">{formatGardenDate(story.data.pubDate)} · {getReadingTime(story.body ?? "")}</span>
        <h2>{story.data.title}</h2>
        <span class="archive-excerpt">{story.data.description}</span>
      </a>
    ))}
  </div>
</BaseLayout>
