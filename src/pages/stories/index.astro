---
import BaseLayout from "@layouts/BaseLayout.astro";
import { getStories } from "@lib/archive";
import { formatGardenDate } from "@lib/date";
import { getReadingTime } from "@lib/readingTime";

const stories = await getStories();
---

<BaseLayout title="Stories — Dipendra Pradhan" description="Journal-like stories and observations by Dipendra Pradhan.">
  <section class="page-intro">
    <p class="eyebrow">Stories</p>
    <h1>Journal entries, field notes, and fragments.</h1>
    <p class="lede">A quiet place for writing now, prepared for future migration from Hawrey Katha.</p>
  </section>

  <div class="story-list">
    {stories.map((story) => (
      <a class="story-row" href={`/stories/${story.id}/`}>
        <span class="meta">{formatGardenDate(story.data.pubDate)} · {getReadingTime(story.body ?? "")}</span>
        <h2>{story.data.title}</h2>
        <span class="archive-excerpt">{story.data.description}</span>
      </a>
    ))}
  </div>
</BaseLayout>
