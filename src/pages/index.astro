---
import { Image } from "astro:assets";
import BaseLayout from "@layouts/BaseLayout.astro";
import ArchiveList from "@components/ArchiveList.astro";
import { getArchiveEntries, getStories } from "@lib/archive";
import { formatGardenDate } from "@lib/date";
import { getFeaturedVisual } from "@lib/visuals";
import { getReadingTime } from "@lib/readingTime";
import { withBase } from "@lib/path";

const stories = await getStories();
const featuredStory = stories.find((story) => story.data.featured) ?? stories[0];
const featuredVisual = getFeaturedVisual();
const recent = (await getArchiveEntries()).slice(0, 5);
---

<BaseLayout title="Dipendra Pradhan — Digital Garden">
  <section class="page-intro" aria-labelledby="home-title">
    <p class="eyebrow">Digital Garden</p>
    <h1 id="home-title">Dipendra Pradhan</h1>
    <p class="lede">Visuals, stories, and observations.</p>
  </section>

  <section class="section split-grid" aria-label="Featured entries">
    <div>
      <div class="section-heading">
        <h2>Featured Visual</h2>
        <a class="quiet-link" href={withBase("/visuals/")}>All visuals</a>
      </div>
      {featuredVisual ? (
        <a class="gallery-item" href={withBase("/visuals/")}>
          <Image src={featuredVisual.image} alt={featuredVisual.caption || featuredVisual.title} widths={[520, 820, 1120]} sizes="(max-width: 820px) 100vw, 60vw" loading="eager" />
          {featuredVisual.caption && <span class="caption">{featuredVisual.caption}</span>}
        </a>
      ) : (
        <p class="empty-note">The visual archive is ready. Add images to <code>/images</code> and the first one will be featured here.</p>
      )}
    </div>

    <div>
      <div class="section-heading">
        <h2>Featured Story</h2>
        <a class="quiet-link" href={withBase("/stories/")}>All stories</a>
      </div>
      {featuredStory && (
        <a class="story-row surface" href={withBase(`/stories/${featuredStory.id}/`)}>
          <span class="meta">{formatGardenDate(featuredStory.data.pubDate)} · {getReadingTime(featuredStory.body ?? "")}</span>
          <h3>{featuredStory.data.title}</h3>
          <span class="archive-excerpt">{featuredStory.data.description}</span>
        </a>
      )}
    </div>
  </section>

  <section class="section" aria-labelledby="recent-title">
    <div class="section-heading">
      <h2 id="recent-title">Recent Additions</h2>
      <a class="quiet-link" href={withBase("/archive/")}>Enter archive</a>
    </div>
    <ArchiveList entries={recent} showTools={false} />
  </section>
</BaseLayout>
